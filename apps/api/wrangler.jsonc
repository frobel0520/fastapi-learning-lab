{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastapi-learning-lab",
  "main": "app/worker.py",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
